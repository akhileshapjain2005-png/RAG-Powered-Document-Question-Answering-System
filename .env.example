OPENAI_API_KEY=replace_me
ENV=production
# Set true only for local/dev when no JWT/API keys are configured
ALLOW_ANONYMOUS_ACCESS=false
ENABLE_API_DOCS=false
LLM_PROVIDER=openai
LLM_MODEL=gpt-3.5-turbo
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_PATH=/app/chroma_db

# Authentication: see ENTERPRISE.md
# anonymous | api_key | jwt | jwt_or_api_key
AUTH_MODE=jwt_or_api_key

# Optional: require API key on protected backend endpoints.
API_KEY=
# Comma-separated list of additional API keys (optional)
API_KEYS=
API_KEY_HEADER_NAME=X-API-Key

# JWT / OIDC (configure one of JWKS, public key, or HS256 secret)
JWT_JWKS_URL=
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_FILE=
JWT_SECRET=
JWT_ALGORITHM=RS256
JWT_ALGORITHMS=RS256,ES256
JWT_ISSUER=
JWT_AUDIENCE=
JWT_TENANT_CLAIM=tenant_id
JWT_ROLES_CLAIM=roles

# RBAC for GET /stats (comma-separated roles; empty = any authenticated user)
STATS_ALLOWED_ROLES=
STATS_ALLOW_API_KEY=true

# Audit & metrics
AUDIT_LOG_ENABLED=true
AUDIT_LOG_ASK=false
ENABLE_METRICS=true
# If set, require X-Metrics-Token or Authorization: Bearer <token> for GET /metrics
METRICS_TOKEN=

# Backend security/runtime settings
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=false
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=500
MAX_EXTRACTED_TEXT_CHARS=5000000
LOG_LEVEL=INFO

# Rate limiting (SlowAPI)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_UPLOAD=20/hour
RATE_LIMIT_ASK=120/hour
RATE_LIMIT_READ=600/hour

# Frontend build-time backend URL for Docker image
VITE_API_URL=/api
VITE_API_KEY=
# Demo only — prefer sessionStorage + OIDC (see ENTERPRISE.md)
VITE_BEARER_TOKEN=
VITE_AUTH_TOKEN_STORAGE_KEY=rag_access_token
